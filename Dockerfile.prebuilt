ARG NODE_IMAGE=node:22.23.1-alpine3.24@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2
FROM ${NODE_IMAGE} AS runtime

ARG APP_UID=10001
ARG APP_GID=10001
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8787
ENV NB_DATA_DIR=/app/data
ENV NB_TRUST_PROXY=0
ENV HOME=/home/nbapp
ENV TMPDIR=/tmp
ENV XDG_CACHE_HOME=/tmp/.cache
ENV XDG_CONFIG_HOME=/tmp/.config
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV NB_MANAGED_EXPORT_CONTAINER_MODE=1

RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont font-noto-cjk \
  && addgroup -S -g "${APP_GID}" nbapp \
  && adduser -S -D -h /home/nbapp -s /sbin/nologin -u "${APP_UID}" -G nbapp nbapp

COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
  && npm cache clean --force

COPY --chown=${APP_UID}:${APP_GID} LICENSE THIRD_PARTY_NOTICES.md ./
COPY --chown=${APP_UID}:${APP_GID} server ./server
COPY --chown=${APP_UID}:${APP_GID} shared ./shared
COPY --chown=${APP_UID}:${APP_GID} scripts/init-admin.js scripts/setup.mjs scripts/start.mjs scripts/doctor.mjs scripts/runtime-config.mjs scripts/sqlite-*.js ./scripts/
COPY --chown=${APP_UID}:${APP_GID} scripts/v2-production/*.mjs ./scripts/v2-production/
COPY --chown=${APP_UID}:${APP_GID} dist ./dist
RUN mkdir -p /app/data /home/nbapp \
  && chown "${APP_UID}:${APP_GID}" /app/data /home/nbapp \
  && chmod 0700 /app/data /home/nbapp

USER ${APP_UID}:${APP_GID}
EXPOSE 8787
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:8787/api/readyz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/index.js"]
