# Local V2 installation. Copy to .env; existing process variables take precedence.
NB_STORAGE_MODE=sqlite-primary
NB_DATA_DIR=./data
NB_V2_IDENTITY_ENABLED=1
NB_V2_PRODUCTION_ENABLED=1
NB_LOCAL_MODE=1
NB_OWNER_PASSWORD_LOGIN=1
NB_BIND_HOST=127.0.0.1
PORT=8787
NB_V2_PUBLIC_ORIGIN=http://127.0.0.1:8787
NB_TRUST_PROXY=0

# Public branding. Frontend VITE_* values require a new build.
NB_BRAND_NAME=Clan Portal
VITE_BRAND_NAME=Clan Portal
# Modified network deployments must provide their corresponding source here.
VITE_SOURCE_URL=https://github.com/anlonely/nb-clan

# Optional integrations: leave blank until configured. Never use VITE_* for secrets.
NB_DISCORD_OAUTH_CLIENT_ID=
NB_DISCORD_OAUTH_CLIENT_SECRET=
NB_DISCORD_BOT_TOKEN=
NB_KOOK_OAUTH_CLIENT_ID=
NB_KOOK_OAUTH_CLIENT_SECRET=
NB_KOOK_BOT_TOKEN=
NB_STEAM_WEB_API_KEY=
NB_WECHAT_APPID=
NB_WECHAT_APP_SECRET=
NB_TRANSLATION_API_BASE_URL=
NB_TRANSLATION_API_KEY=
NB_TRANSLATION_MODEL=
NB_DISABLE_EXTERNAL_VITAL=1
