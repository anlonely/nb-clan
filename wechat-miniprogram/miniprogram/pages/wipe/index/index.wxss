.roster-heading .section-title{flex:1;min-width:0;margin:0}
.page .roster-refresh{flex:0 0 112rpx;width:112rpx;min-width:112rpx;max-width:112rpx;margin:0 0 0 auto;padding:0 16rpx}
.roster-counts{margin-top:16rpx}
.page .roster-more{width:100%;max-width:100%;height:auto;line-height:1.5;padding:22rpx 24rpx;white-space:normal}
.participant-row-hover{background:var(--soft)}
.participant-mask{position:fixed;inset:0;z-index:80;display:flex;align-items:center;justify-content:center;padding:36rpx;background:rgba(10,20,35,.55)}
.participant-dialog{width:100%;max-width:640rpx;max-height:80vh;overflow-y:auto;padding:30rpx;background:var(--card);border-radius:24rpx}
.participant-dialog-heading{margin-bottom:26rpx}
.participant-dialog-heading .section-title{margin:0}
.page .participant-close{flex:0 0 64rpx;width:64rpx;min-width:64rpx;max-width:64rpx;margin:0;padding:0;font-size:38rpx;line-height:64rpx}
.participant-steam{border-radius:16rpx;background:var(--bg);padding:22rpx}
.participant-steam-id{display:block;color:var(--blue);font-size:30rpx;line-height:1.5;word-break:break-all}
.server-info{display:flex;align-items:center;gap:20rpx;margin-top:20rpx;padding:22rpx;border-radius:18rpx;background:var(--bg)}
.server-info-content{flex:1;min-width:0}
.server-info-value{display:block;font-size:26rpx;line-height:1.6;word-break:break-all;white-space:normal}
.page .server-info-copy{flex:0 0 104rpx;width:104rpx;min-width:104rpx;max-width:104rpx;margin:0;padding:0 12rpx}
