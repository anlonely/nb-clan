{
  "pages": [
    "pages/launch/index/index",
    "pages/gate/index/index",
    "pages/link/index/index",
    "pages/wipe/index/index",
    "pages/members/index/index",
    "pages/rankings/index/index",
    "pages/mine/index/index"
  ],
  "__usePrivacyCheck__": true,
  "window": {
    "navigationBarTitleText": "NB Clan",
    "navigationBarBackgroundColor": "@navigationBarBackgroundColor",
    "navigationBarTextStyle": "@navigationBarTextStyle",
    "backgroundColor": "@backgroundColor",
    "backgroundTextStyle": "@backgroundTextStyle"
  },
  "tabBar": {
    "color": "@tabBarColor",
    "selectedColor": "@tabBarSelectedColor",
    "backgroundColor": "@tabBarBackgroundColor",
    "borderStyle": "@tabBarBorderStyle",
    "list": [
      {
        "pagePath": "pages/link/index/index",
        "text": "关联",
        "iconPath": "images/tab/query-normal.png",
        "selectedIconPath": "images/tab/query-active.png"
      },
      {
        "pagePath": "pages/wipe/index/index",
        "text": "开荒",
        "iconPath": "images/tab/wipe-normal.png",
        "selectedIconPath": "images/tab/wipe-active.png"
      },
      {
        "pagePath": "pages/members/index/index",
        "text": "队伍",
        "iconPath": "images/tab/mine-normal.png",
        "selectedIconPath": "images/tab/mine-active.png"
      },
      {
        "pagePath": "pages/rankings/index/index",
        "text": "排行",
        "iconPath": "images/tab/rankings-normal.png",
        "selectedIconPath": "images/tab/rankings-active.png"
      },
      {
        "pagePath": "pages/mine/index/index",
        "text": "我的",
        "iconPath": "images/tab/profile-normal.png",
        "selectedIconPath": "images/tab/profile-active.png"
      }
    ]
  },
  "style": "v2",
  "componentFramework": "glass-easel",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json",
  "themeLocation": "theme.json",
  "darkmode": true
}
